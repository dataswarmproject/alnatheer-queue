# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/
*.tsbuildinfo
apps/web/typescript-errors.txt

# Turbo
.turbo/

# Vercel
.vercel/

# Environments — never commit a real value
.env
.env.local
.env.*.local
services/ai-engine/.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Tool-local state (IDE / agent settings live outside the repo)
.claude/
.cursor/
.vscode/settings.local.json
.idea/

# Husky helper scripts (regenerated by `pnpm prepare`)
.husky/_/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
playwright-report/
test-results/
coverage/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Claude Code skill installer state
.skill-install/

# Locally supplied font assets; retain the vendor licence locally.
apps/web/local-fonts/

# Private deployment backups and receipts
/backups/

# Branch queue state and private pairing records
queue-data/
*.queue-pairing.json
*.pgdata.tar.gz
*.pgdata.tar.gz.manifest.json
apps/queue-desktop/release/
apps/queue-desktop/out/
queue-audit.local.json
queue-dependencies.local.json

# Generated ticket proof files; production print templates remain in source.
/output/pdf/alnatheer-ticket-*
# Supplied licensed font files are embedded in packaged apps, never published as raw source.
/apps/queue-desktop/src/renderer/public/fonts/thmanyahsans-*.woff2
/apps/queue-desktop/src/renderer/public/fonts/Thmanyah-LICENSE.pdf
# Private branch operation credentials live outside source control.
**/operations.json
# Locally exported report proofs are data, not application source.
/apps/queue-desktop/queue-performance-*.json
# Signing private keys and local identity records must stay outside Git.
*.pfx
*.p12
signer.json
