{
  "name": "alnatheer-queue",
  "version": "0.4.3",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "pnpm": {
    "overrides": {
      "ajv@8.20.0>fast-uri": "3.1.8",
      "@types/react": "18.3.28"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "scripts": {
    "typecheck": "pnpm --filter @saraf/queue-core typecheck && pnpm --filter @saraf/queue-branch typecheck && pnpm --filter @saraf/queue-desktop typecheck",
    "test": "pnpm --filter @saraf/queue-branch test",
    "build": "pnpm --filter @saraf/queue-branch build && pnpm --filter @saraf/queue-desktop build",
    "package:win": "pnpm --filter @saraf/queue-desktop package:win"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
