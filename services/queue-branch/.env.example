# Set to the real SARAF branch UUID before connecting to headquarters.
QUEUE_BRANCH_ID=
QUEUE_DATA_DIR=./queue-data
QUEUE_LISTEN_HOST=127.0.0.1
QUEUE_LISTEN_PORT=4318
# Required for LAN listeners: use a certificate trusted by each branch PC.
QUEUE_TLS_CERT=
QUEUE_TLS_KEY=
# Optional: retain local events until SARAF accepts them.
QUEUE_SYNC_URL=
QUEUE_SYNC_KEY=
# Optional: export the completed Riyadh day automatically (private folder).
QUEUE_REPORT_DIR=
# Optional: private, automatic daily backups on the branch host.
QUEUE_BACKUP_DIR=
# Natural full-sentence Arabic speech. Keep this key private on the host.
QUEUE_SPEECH_VOICE_ID=
QUEUE_SPEECH_API_KEY=
QUEUE_SPEECH_MODEL=eleven_multilingual_v2
QUEUE_SPEECH_CACHE_DIR=./speech-cache
QUEUE_SPEECH_DAILY_LIMIT=500
